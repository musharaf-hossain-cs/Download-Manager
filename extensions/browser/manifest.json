{
  "manifest_version": 3,
  "name": "Download Manager",
  "description": "Send selected downloads to the local Download Manager application.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "key": "",
  "incognito": "split",
  "permissions": ["nativeMessaging", "downloads", "contextMenus", "storage"],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Download Manager"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
