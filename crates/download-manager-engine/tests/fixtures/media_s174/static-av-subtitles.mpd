<?xml version="1.0" encoding="UTF-8"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static" mediaPresentationDuration="PT6S">
  <Period id="cc0-period" duration="PT6S">
    <AdaptationSet id="video" contentType="video" mimeType="video/mp4" codecs="avc1.64001f">
      <Representation id="video-720" bandwidth="1500000" width="1280" height="720" frameRate="30">
        <SegmentTemplate timescale="1" duration="2" startNumber="1"
          initialization="video-init.mp4" media="video-$Number$.m4s" />
      </Representation>
    </AdaptationSet>
    <AdaptationSet id="audio" contentType="audio" mimeType="audio/mp4" codecs="mp4a.40.2" lang="en">
      <Representation id="audio-en" bandwidth="128000">
        <SegmentTemplate timescale="1" duration="2" startNumber="1"
          initialization="audio-init.mp4" media="audio-$Number$.m4s" />
      </Representation>
    </AdaptationSet>
    <AdaptationSet id="captions" contentType="text" mimeType="text/vtt" lang="en">
      <Representation id="captions-en" bandwidth="256">
        <BaseURL>captions-en.vtt</BaseURL>
      </Representation>
    </AdaptationSet>
  </Period>
</MPD>
