{
  "name": "@download-manager/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm typecheck && pnpm build:ui",
    "build:ui": "tsc --project tsconfig.ui.json",
    "prepare:tauri": "pnpm build:ui && cargo build --manifest-path ../../Cargo.toml -p download-manager-cli --bin download-manager-backend",
    "tauri": "tauri",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4"
  }
}
