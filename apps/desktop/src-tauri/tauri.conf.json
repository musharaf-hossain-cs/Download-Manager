{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Download Manager",
  "version": "1.0.0",
  "identifier": "io.github.musharaf-hossain-cs.download-manager",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm prepare:tauri",
      "wait": true
    },
    "beforeBuildCommand": "pnpm build:ui",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Download Manager",
        "width": 920,
        "height": 680,
        "minWidth": 520,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico"],
    "externalBin": [
      "binaries/download-manager-backend",
      "binaries/download-manager-cli",
      "binaries/download-manager-native-host"
    ],
    "resources": {
      "../../../packaging/windows/native-host-registration.ps1": "native-host-registration.ps1",
      "../../../packaging/windows/PRIVATE_BROWSER_SETUP.txt": "BROWSER_SETUP.txt",
      "../../../extensions/browser/dist/chromium/": "browser-extension/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  }
}
