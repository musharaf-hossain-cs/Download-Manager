{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Download Manager",
  "version": "0.1.0",
  "identifier": "io.github.musharaf-hossain-cs.download-manager",
  "build": {
    "beforeDevCommand": {
      "script": "cargo build --manifest-path ../../Cargo.toml -p download-manager-cli --bin download-manager-backend",
      "wait": true
    },
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Download Manager",
        "width": 720,
        "height": 480,
        "minWidth": 520,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "nsis"
  }
}
